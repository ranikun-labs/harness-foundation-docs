@@ -0,0 +1,31 @@
+import { useEffect, useState } from 'react';
+
+type Message = {role: 'user' | 'assistant'; text: string};
+type Conversation = {id: string; title: string};
+const base = '/synthetic-conversations';
+async function api<T>(actor: string, path: string, method = 'GET', body?: unknown): Promise<T> {
+  const res = await fetch(base + path, {method, headers: {'content-type':'application/json', 'x-fixture-actor':actor}, body: body === undefined ? undefined : JSON.stringify(body)});
+  if (!res.ok) throw new Error('요청을 완료하지 못했습니다.');
+  return (res.status === 204 ? null : await res.json()) as T;
+}
+export function SyntheticConversationPage() {
+  const [actor, setActor] = useState(() => { const saved = sessionStorage.getItem('syntheticConversationActor') ?? ''; return ['fixture-a', 'fixture-b', 'fixture-c'].includes(saved) ? saved : ''; });
+  function switchActor(value: string) {
+    if (['fixture-a', 'fixture-b', 'fixture-c'].includes(value)) sessionStorage.setItem('syntheticConversationActor', value);
+    else sessionStorage.removeItem('syntheticConversationActor');
+    setActor(value);
+  }
+  return <><div className="px-5 pt-5"><label>로컬 합성 사용자 <select aria-label="로컬 합성 사용자" value={actor} onChange={e => switchActor(e.target.value)}><option value="">선택 안 함</option><option value="fixture-a">사용자 A</option><option value="fixture-b">사용자 B</option><option value="fixture-c">다른 조직 사용자</option></select></label> <button onClick={() => switchActor('')}>합성 사용자 로그아웃</button></div>{actor ? <Conversation key={actor} actor={actor} /> : <p className="px-5">합성 사용자를 선택하세요.</p>}</>;
+}
+function Conversation({actor}: {actor: string}) {
+  const [saved, setSaved] = useState(false); const [id, setId] = useState<string | null>(null);
+  const [conversations, setConversations] = useState<Conversation[]>([]); const [messages, setMessages] = useState<Message[]>([]);
+  const [text,setText] = useState(''); const [status,setStatus] = useState(''); const [busy,setBusy] = useState(false);
+  const refresh = async () => setConversations(await api<Conversation[]>(actor, ''));
+  useEffect(() => { void refresh().catch(() => setStatus('저장된 대화를 불러오지 못했습니다.')); }, []);
+  async function create() { try { setMessages([]);setId(null); if (saved) {const c=await api<Conversation>(actor, '', 'POST', {save:true});setId(c.id);await refresh();setStatus('저장할 대화를 만들었습니다.');} else setStatus('저장하지 않는 임시 대화입니다.'); } catch {setStatus('대화를 만들지 못했습니다.');} }
+  async function open(c: Conversation) { try {const data=await api<{messages: Message[]}>(actor, '/' +c.id);setId(c.id);setMessages(data.messages);setStatus('저장된 대화를 열었습니다.');}catch{setStatus('대화를 열지 못했습니다.');} }
+  async function remove(c: Conversation) {try {await api(actor, '/'+c.id,'DELETE');if(id===c.id){setId(null);setMessages([]);}await refresh();setStatus('대화를 삭제했습니다.');}catch{setStatus('대화를 삭제하지 못했습니다.');}}
+  async function submit(e: React.FormEvent) { e.preventDefault(); const input=text.trim();if(!input||busy)return;setText('');setBusy(true);try { if (!id) {setMessages(v=>[...v,{role:'user',text:input},{role:'assistant',text:'합성 예시 답변입니다. 실제 금융 분석이 아닙니다.'}]);} else {const key=crypto.randomUUID();await api(actor, '/'+id+'/messages','POST',{key,text:input});await api(actor, '/'+id+'/complete','POST',{key});setMessages((await api<{messages:Message[]}>(actor, '/'+id)).messages);} }catch{setStatus('질문을 처리하지 못했습니다.');}finally{setBusy(false);} }
+  return <div style={{maxWidth:700, margin:'3rem auto',padding:'0 1rem',fontFamily:'system-ui'}}><h1>대화 합성 실험</h1><p>로컬 시험용 합성 답변입니다. 저장한 대화는 로컬 시험 데이터베이스에 남습니다.</p><label><input type="checkbox" checked={saved} onChange={e=>setSaved(e.target.checked)}/> 이 대화를 저장할게요 (로컬 합성 시험)</label> <button disabled={busy} onClick={()=>void create()}>새 대화</button><h2>저장된 대화</h2><ul>{conversations.map(c=><li key={c.id}><button disabled={busy} onClick={()=>void open(c)}>{c.title}</button> <button disabled={busy} onClick={()=>void remove(c)}>삭제</button></li>)}</ul><h2>현재 대화</h2><div>{messages.map((m,i)=><p key={i}>{m.role==='user'?'나: ':'답변: '}{m.text}</p>)}</div><form onSubmit={e=>void submit(e)}><label>질문 <input value={text} maxLength={2000} required onChange={e=>setText(e.target.value)} /></label> <button disabled={busy}>보내기</button></form><p role="status">{status}</p></div>;
+}
