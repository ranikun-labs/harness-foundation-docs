+        assertEquals(Optional.of("방문 목적: 이전 상담 내용 확인"), app.prepare(SCOPE));
+        f.authorized = false; int reads = f.reads; assertTrue(app.prepare(SCOPE).isEmpty()); assertEquals(reads, f.reads);
+        f.authorized = true; assertTrue(app.prepare(OTHER).isEmpty()); f.planned = false; assertTrue(app.prepare(SCOPE).isEmpty());
+        f.planned = true; VisitAccess revoked = scope -> { Optional<Visit> v = f.authorizedRead(scope); f.authorized = false; return v; };
+        assertTrue(new PlannedVisitExperiment(revoked, f).prepare(SCOPE).isEmpty());
+    }
