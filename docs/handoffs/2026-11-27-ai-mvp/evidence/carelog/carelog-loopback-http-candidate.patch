+class PlannedVisitExperimentTest {
+    static final Scope SCOPE = new Scope("W1", "C1", "E1");
+    static final Scope OTHER = new Scope("W1", "C1", "E2");
+    static final class Fake implements VisitAccess, AtomicSave {
+        boolean authorized = true; boolean planned = true; String revision = "v1"; String note = "이전 상담 내용 확인";
+        int reads; int writes; final Map<String, SaveIntent> intents = new HashMap<>();
+        public synchronized Optional<Visit> authorizedRead(Scope scope) {
+            if (!authorized || !SCOPE.equals(scope)) return Optional.empty();
+            reads++; return Optional.of(new Visit(SCOPE, revision, planned, note));
+        }
+        public synchronized SaveResult appendIfAuthorized(SaveIntent intent) {
+            if (!authorized || !(SCOPE.equals(intent.scope()) || OTHER.equals(intent.scope())) || !planned) return SaveResult.UNAVAILABLE;
+            SaveIntent prior = intents.get(intent.id());
+            if (prior != null) return prior.equals(intent) ? SaveResult.REPLAYED : SaveResult.CONFLICT;
+            if (!SCOPE.equals(intent.scope())) return SaveResult.UNAVAILABLE;
+            if (!revision.equals(intent.confirmedRevision())) return SaveResult.CONFLICT;
+            note += "\n" + intent.addition(); revision = "v2"; writes++; intents.put(intent.id(), intent);
+            return SaveResult.APPLIED;
+        }
+    }
+    static SaveIntent intent() { return new SaveIntent("intent1", SCOPE, "v1", "확인한 추가 내용"); }
