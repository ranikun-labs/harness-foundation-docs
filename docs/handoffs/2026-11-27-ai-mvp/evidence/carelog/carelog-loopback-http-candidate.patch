+@ActiveProfiles("test") @Import(PostgreSqlTestContainerConfiguration.class)
+class AiMemoLoopbackHttpIntegrationTest {
+    @Autowired UserRepository users; @Autowired RelationRepository relations; @Autowired CustomerEventRepository events;
+    @Autowired TestRestTemplate http; @Autowired ObjectMapper json; @LocalServerPort int port;
+    @Test void authenticatesAndProtectsSaveAcrossActualHttp() throws Exception {
+        UUID org=UUID.randomUUID(), actor=UUID.randomUUID();
+        User m=User.externalManager(actor,"s-"+actor,actor+"@example.test","합성 관리자",org); users.saveAndFlush(m);
+        User c=User.builder().name("합성 고객").role(UserRole.CUSTOMER).build(); c.assignOrganization(org); users.saveAndFlush(c);
+        Relation r=Relation.create(m,c); r.assignOrganization(org); relations.saveAndFlush(r);
+        CustomerEvent e=CustomerEvent.createPlanned(c,OffsetDateTime.parse("2026-12-01T10:00:00Z"),"합성 상담","기존 메모"); e.assignOrganization(org); events.saveAndFlush(e);
+        String root="http://127.0.0.1:"+port+"/api/v1/customer-events/"+e.getPublicId();
+        HttpHeaders h=new HttpHeaders(); h.setContentType(MediaType.APPLICATION_JSON); h.set("X-Gateway-Secret","test-gateway-internal-secret"); h.set("X-User-Id",actor.toString()); h.set("X-Organization-Id",org.toString()); h.set("X-Role","MANAGER"); h.set("X-Public-Id",m.getPublicId().toString());
+        UUID session=UUID.randomUUID(), intent=UUID.randomUUID(); Map<String,Object> prep=Map.of("customerId",c.getPublicId(),"sessionId",session);
+        HttpHeaders wrong=new HttpHeaders(); wrong.putAll(h); wrong.set("X-Organization-Id",UUID.randomUUID().toString());
+        assertEquals(HttpStatus.FORBIDDEN,http.postForEntity(root+"/synthetic-prepare",new HttpEntity<>(prep,wrong),String.class).getStatusCode());
+        var prepared=http.postForEntity(root+"/synthetic-prepare",new HttpEntity<>(prep,h),String.class); assertEquals(HttpStatus.OK,prepared.getStatusCode());
+        var data=json.readTree(Objects.requireNonNull(prepared.getBody())).get("data"); assertEquals("방문 목적: 합성 상담",data.get("summary").asText());
+        Map<String,Object> append=Map.of("customerId",c.getPublicId(),"sessionId",session,"token",data.get("token").asText(),"expectedRevision",data.get("revision").asLong(),"intentId",intent,"addition","확인 내용");
+        assertEquals(HttpStatus.FORBIDDEN,http.postForEntity(root+"/ai-memo-append",new HttpEntity<>(append,wrong),String.class).getStatusCode());
+        assertEquals("기존 메모",events.findByOrganizationIdAndPublicId(org,e.getPublicId()).orElseThrow().getNote());
+        assertEquals(HttpStatus.OK,http.postForEntity(root+"/ai-memo-append",new HttpEntity<>(append,h),String.class).getStatusCode());
+        assertEquals(HttpStatus.OK,http.postForEntity(root+"/ai-memo-append",new HttpEntity<>(append,h),String.class).getStatusCode());
+        Map<String,Object> changed=new HashMap<>(append); changed.put("addition","다른 내용");
+        assertEquals(HttpStatus.CONFLICT,http.postForEntity(root+"/ai-memo-append",new HttpEntity<>(changed,h),String.class).getStatusCode());
+        assertEquals("기존 메모\n확인 내용",events.findByOrganizationIdAndPublicId(org,e.getPublicId()).orElseThrow().getNote());
+        var again=http.postForEntity(root+"/synthetic-prepare",new HttpEntity<>(prep,h),String.class); assertEquals(HttpStatus.OK,again.getStatusCode());
+        var fresh=json.readTree(Objects.requireNonNull(again.getBody())).get("data");
+        var request=java.net.http.HttpRequest.newBuilder(java.net.URI.create(root)).header("Content-Type","application/json").header("X-Gateway-Secret","test-gateway-internal-secret").header("X-User-Id",actor.toString()).header("X-Organization-Id",org.toString()).header("X-Role","MANAGER").header("X-Public-Id",m.getPublicId().toString()).method("PATCH",java.net.http.HttpRequest.BodyPublishers.ofString("{\"note\":\"다른 편집\",\"expectedRevision\":"+fresh.get("revision").asLong()+"}")).build();
+        assertEquals(200,java.net.http.HttpClient.newHttpClient().send(request,java.net.http.HttpResponse.BodyHandlers.ofString()).statusCode());
+        Map<String,Object> stale=Map.of("customerId",c.getPublicId(),"sessionId",session,"token",fresh.get("token").asText(),"expectedRevision",fresh.get("revision").asLong(),"intentId",UUID.randomUUID(),"addition","오래된 추가");
+        assertEquals(HttpStatus.CONFLICT,http.postForEntity(root+"/ai-memo-append",new HttpEntity<>(stale,h),String.class).getStatusCode());
+        assertEquals("다른 편집",events.findByOrganizationIdAndPublicId(org,e.getPublicId()).orElseThrow().getNote());
+    }
+}
