+package carelog.carelog.customerevent.ai;
+
+import carelog.carelog.auth.app.UserPrincipal;
+import carelog.carelog.common.web.dto.response.ApiResponse;
+import java.util.UUID;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.context.annotation.Profile;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.security.core.annotation.AuthenticationPrincipal;
+import org.springframework.web.bind.annotation.*;
+
+/** 비활성 출시 후보: 별도 결과 검증 및 보존 승인 전 운영 활성화 금지. */
+@RestController
+@RequestMapping("/customer-events")
+@PreAuthorize("hasRole('MANAGER')")
+@Profile("test")
+@ConditionalOnProperty(name="carelog.ai-memo.enabled", havingValue="true")
+public class AiMemoAppendController {
+    private final AiMemoAppendService service;
+    public AiMemoAppendController(AiMemoAppendService service) { this.service=service; }
+    public record PrepareRequest(UUID customerId, UUID sessionId) {}
+    @PostMapping("/{eventId}/synthetic-prepare")
+    public ResponseEntity<ApiResponse<AiMemoAppendService.Preparation>> prepare(@AuthenticationPrincipal UserPrincipal principal,@PathVariable UUID eventId,@RequestBody PrepareRequest request) {
+        return ApiResponse.ok(service.prepare(principal,eventId,request.customerId(),request.sessionId()));
+    }
+    @PostMapping("/{eventId}/ai-memo-append")
+    public ResponseEntity<ApiResponse<AiMemoAppendService.Receipt>> append(@AuthenticationPrincipal UserPrincipal principal,@PathVariable UUID eventId,@RequestBody AiMemoAppendService.Request request) {
+        return ApiResponse.ok(service.append(principal,eventId,request));
+    }
+}
