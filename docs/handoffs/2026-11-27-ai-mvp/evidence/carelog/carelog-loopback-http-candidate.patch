+        Fake f = new Fake(); PlannedVisitExperiment app = new PlannedVisitExperiment(f, f);
+        assertEquals(SaveResult.APPLIED, app.save(intent())); assertEquals("이전 상담 내용 확인\n확인한 추가 내용", f.note);
+        assertEquals(SaveResult.REPLAYED, app.save(intent())); assertEquals(1, f.writes);
+        assertEquals(SaveResult.CONFLICT, app.save(new SaveIntent("intent1", SCOPE, "v1", "변경된 내용")));
+        assertEquals(SaveResult.CONFLICT, app.save(new SaveIntent("intent1", OTHER, "v1", "확인한 추가 내용"))); assertEquals(1, f.writes);
+        f.authorized = false; assertEquals(SaveResult.UNAVAILABLE, app.save(intent())); assertEquals(1, f.writes);
+    }
+    @Test void staleOrUnauthorizedOrChangedTargetCannotWrite() {
+        Fake f = new Fake(); PlannedVisitExperiment app = new PlannedVisitExperiment(f, f);
+        f.revision = "v2"; assertEquals(SaveResult.CONFLICT, app.save(intent()));
+        f.revision = "v1"; f.authorized = false; assertEquals(SaveResult.UNAVAILABLE, app.save(intent()));
+        f.authorized = true; assertEquals(SaveResult.UNAVAILABLE, app.save(new SaveIntent("intent1", OTHER, "v1", "추가")));
+        f.planned = false; assertEquals(SaveResult.UNAVAILABLE, app.save(intent())); assertEquals(0, f.writes);
+    }
+    @Test void concurrentReplaysProduceExactlyOneWrite() throws Exception {
+        Fake f = new Fake(); PlannedVisitExperiment app = new PlannedVisitExperiment(f, f); ExecutorService pool = Executors.newFixedThreadPool(2);
+        try { CountDownLatch start = new CountDownLatch(1); Callable<SaveResult> call = () -> { start.await(); return app.save(intent()); };
+            Future<SaveResult> a = pool.submit(call), b = pool.submit(call); start.countDown();
+            assertEquals(Set.of(SaveResult.APPLIED, SaveResult.REPLAYED), Set.of(a.get(5, TimeUnit.SECONDS), b.get(5, TimeUnit.SECONDS))); assertEquals(1, f.writes);
+        } finally { pool.shutdownNow(); }
+    }
+}
diff --git a/carelog-be/src/test/java/carelog/carelog/preparation/SyntheticPreparationTest.java b/carelog-be/src/test/java/carelog/carelog/preparation/SyntheticPreparationTest.java
new file mode 100644
index 0000000..48a5acd
--- /dev/null
+++ b/carelog-be/src/test/java/carelog/carelog/preparation/SyntheticPreparationTest.java
@@ -0,0 +1,76 @@
+package carelog.carelog.preparation;
+
+import org.junit.jupiter.api.Test;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicInteger;
+import static org.junit.jupiter.api.Assertions.*;
+import static carelog.carelog.preparation.SyntheticPreparation.*;
+
+/** 합성 전용 계약 실험. 운영 인가, 저장소, 모델, HTTP 연결이 아니다. */
+class SyntheticPreparationTest {
+    static final class Fixture implements FixtureAccess {
+        volatile Snapshot value = GOOD;
+        int reads;
+        public Snapshot read(Scope scope) { reads++; return value; }
+    }
+    @Test void authorizedReturnsExactKoreanAndEvidenceAndReopens() {
+        Fixture f = new Fixture(); Session s = new Session(f, SyntheticPreparation::deterministic); s.select(SCOPE);
+        assertEquals(Optional.of(EXPECTED), s.prepare(SCOPE)); assertEquals(Optional.of(EXPECTED), s.reopen());
+        assertEquals(List.of(EVENT, HISTORY), s.reopen().orElseThrow().evidence());
+    }
+    @Test void deniedOrWrongSelectionNeverCallsGenerator() {
+        AtomicInteger calls = new AtomicInteger(); Fixture f = new Fixture();
+        Session s = new Session(f, x -> { calls.incrementAndGet(); return EXPECTED; }); s.select(SCOPE);
+        for (Snapshot denied : List.of(new Snapshot(SCOPE, false, true, EVENT, List.of(HISTORY)), new Snapshot(SCOPE, true, false, EVENT, List.of(HISTORY)), new Snapshot(new Scope("W2", "C1", "E1"), true, true, EVENT, List.of(HISTORY)), new Snapshot(new Scope("W1", "C2", "E1"), true, true, EVENT, List.of(HISTORY)))) {
+            f.value = denied; assertTrue(s.prepare(SCOPE).isEmpty());
+        }
+        assertTrue(s.prepare(new Scope("W1", "C1", "E2")).isEmpty()); assertEquals(0, calls.get());
+    }
+    @Test void mixedUnapprovedHistoryNeverReachesGenerator() {
+        Fixture f = new Fixture(); AtomicInteger calls = new AtomicInteger();
+        f.value = new Snapshot(SCOPE, true, true, EVENT, List.of(HISTORY, new Source("H2.note", "v1", "excluded")));
+        Session s = new Session(f, x -> { calls.incrementAndGet(); return EXPECTED; }); s.select(SCOPE);
+        assertTrue(s.prepare(SCOPE).isEmpty()); assertEquals(0, calls.get()); assertTrue(s.reopen().isEmpty());
+    }
+    @Test void delayedDifferentSelectionDoesNotInvalidateResultOrInflightRequest() throws Exception {
+        Fixture f = new Fixture(); CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1);
+        Session s = new Session(f, x -> { entered.countDown(); try { release.await(); } catch (InterruptedException e) { Thread.currentThread().interrupt(); throw new IllegalStateException(e); } return EXPECTED; });
+        s.select(SCOPE); ExecutorService pool = Executors.newSingleThreadExecutor();
+        try {
+            Future<Optional<Briefing>> pending = pool.submit(() -> s.prepare(SCOPE)); assertTrue(entered.await(5, TimeUnit.SECONDS));
+            int reads = f.reads; assertTrue(s.prepare(new Scope("W1", "C1", "E2")).isEmpty()); assertEquals(reads, f.reads);
+            release.countDown(); assertEquals(Optional.of(EXPECTED), pending.get(5, TimeUnit.SECONDS));
+            assertTrue(s.prepare(new Scope("W1", "C1", "E2")).isEmpty()); assertEquals(Optional.of(EXPECTED), s.reopen());
+        } finally { release.countDown(); pool.shutdownNow(); }
+    }
+    @Test void rejectsAlteredClaimsAndEvidence() {
+        for (Briefing bad : List.of(new Briefing(EXPECTED.purpose(), "일정 변경이 확정되었습니다.", EXPECTED.check(), EXPECTED.question(), EXPECTED.evidence()), new Briefing(EXPECTED.purpose(), EXPECTED.context(), EXPECTED.check(), EXPECTED.question(), List.of(EVENT)), new Briefing(EXPECTED.purpose(), EXPECTED.context(), EXPECTED.check(), EXPECTED.question(), List.of(EVENT, new Source("other", "v1", "secret"))))) {
+            Session s = new Session(new Fixture(), x -> bad); s.select(SCOPE); assertTrue(s.prepare(SCOPE).isEmpty()); assertTrue(s.reopen().isEmpty());
+        }
+    }
+    @Test void rechecksRevocationAndSourceChangesAndDiscards() {
+        Fixture f = new Fixture(); Session s = new Session(f, SyntheticPreparation::deterministic); s.select(SCOPE);
+        assertTrue(s.prepare(SCOPE).isPresent()); f.value = new Snapshot(SCOPE, false, true, EVENT, List.of(HISTORY)); assertTrue(s.reopen().isEmpty());
+        f.value = GOOD; assertTrue(s.reopen().isEmpty()); assertTrue(s.prepare(SCOPE).isPresent());
+        f.value = new Snapshot(SCOPE, true, true, new Source(EVENT.id(), "v2", EVENT.text()), List.of(HISTORY)); assertTrue(s.reopen().isEmpty());
+    }
+    @Test void lateResponseAfterSelectionChangeOrCancelIsDiscarded() throws Exception {
+        for (boolean cancel : List.of(false, true)) {
+            Fixture f = new Fixture(); CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1);
+            Session s = new Session(f, x -> { entered.countDown(); try { release.await(); } catch (InterruptedException e) { Thread.currentThread().interrupt(); throw new IllegalStateException(e); } return EXPECTED; });
+            s.select(SCOPE); ExecutorService pool = Executors.newSingleThreadExecutor();
+            try { Future<Optional<Briefing>> pending = pool.submit(() -> s.prepare(SCOPE)); assertTrue(entered.await(5, TimeUnit.SECONDS)); if (cancel) s.cancel(); else s.select(new Scope("W1", "C1", "E2")); release.countDown(); assertTrue(pending.get(5, TimeUnit.SECONDS).isEmpty()); assertTrue(s.reopen().isEmpty()); } finally { release.countDown(); pool.shutdownNow(); }
+        }
+    }
+    @Test void olderRequestCannotReplaceNewerResult() throws Exception {
+        Fixture f = new Fixture(); CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1); AtomicInteger calls = new AtomicInteger();
+        Session s = new Session(f, x -> { if (calls.incrementAndGet() == 1) { entered.countDown(); try { release.await(); } catch (InterruptedException e) { Thread.currentThread().interrupt(); throw new IllegalStateException(e); } } return EXPECTED; });
+        s.select(SCOPE); ExecutorService pool = Executors.newSingleThreadExecutor();
+        try { Future<Optional<Briefing>> old = pool.submit(() -> s.prepare(SCOPE)); assertTrue(entered.await(5, TimeUnit.SECONDS)); assertEquals(Optional.of(EXPECTED), s.prepare(SCOPE)); release.countDown(); assertTrue(old.get(5, TimeUnit.SECONDS).isEmpty()); assertEquals(Optional.of(EXPECTED), s.reopen()); } finally { release.countDown(); pool.shutdownNow(); }
+    }
+    @Test void sourceChangesDuringExecutionAndClosedSessionFailClosed() {
+        Fixture f = new Fixture(); Session s = new Session(f, x -> { f.value = new Snapshot(SCOPE, false, true, EVENT, List.of(HISTORY)); return EXPECTED; }); s.select(SCOPE);
+        assertTrue(s.prepare(SCOPE).isEmpty()); s.close(); f.value = GOOD; assertTrue(s.prepare(SCOPE).isEmpty()); assertTrue(s.reopen().isEmpty());
+    }
+}
