+++ b/carelog-be/src/main/java/carelog/carelog/customerevent/ai/AiMemoAppendService.java
@@ -0,0 +1,95 @@
+package carelog.carelog.customerevent.ai;
+
+import carelog.carelog.auth.app.UserPrincipal;
+import carelog.carelog.common.web.exception.CustomException;
+import carelog.carelog.common.web.exception.ExceptionStatus;
+import carelog.carelog.customerevent.domain.*;
+import carelog.carelog.relation.domain.*;
+import carelog.carelog.user.domain.*;
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.context.annotation.Profile;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/** 출시 비활성 후보. 원본/결과 결속, 보존 정책은 별도 승인 전 활성화 금지. */
+@Service
+@Profile("test")
+@ConditionalOnProperty(name="carelog.ai-memo.enabled", havingValue="true")
+public class AiMemoAppendService {
+    private final UserRepository users;
+    private final RelationRepository relations;
+    private final CustomerEventRepository events;
+    private final JdbcTemplate jdbc;
+    public AiMemoAppendService(UserRepository users, RelationRepository relations, CustomerEventRepository events, JdbcTemplate jdbc) {
+        this.users=users; this.relations=relations; this.events=events; this.jdbc=jdbc;
+    }
+    public record Request(UUID customerId, UUID intentId, Long expectedRevision, String addition, UUID sessionId, UUID token) {}
+    public record Preparation(UUID token, long revision, String summary) {}
+    private record SessionKey(UUID actor, UUID org, UUID session) {}
+    private record Bound(UUID token, UUID customer, UUID event, long revision, long expires) {}
+    private final Map<SessionKey, Bound> prepared = new ConcurrentHashMap<>();
+    // 합성 시험의 수명만 정의한다. 운영 보존 정책이 아니다.
+    private static final long TEST_LIFETIME = TimeUnit.MINUTES.toNanos(2);
+    @Transactional
+    public Preparation prepare(UserPrincipal principal, UUID eventId, UUID customerId, UUID sessionId) {
+        if (sessionId==null) throw denied();
+        lockSession(principal,sessionId);
+        CustomerEvent event = authorize(principal,eventId,customerId);
+        UUID token=UUID.randomUUID();
+        SessionKey key=new SessionKey(principal.getAccountId(),principal.getOrganizationId(),sessionId);
+        prepared.put(key,new Bound(token,customerId,eventId,event.getRevision(),System.nanoTime()+TEST_LIFETIME));
+        String descriptor=event.getDescriptor();
+        return new Preparation(token,event.getRevision(),descriptor==null?"방문 목적: 기록 없음":"방문 목적: "+descriptor);
+    }
+    // 만료 동작을 대기 없이 검증하기 위한 테스트 프로필 전용 훅이다.
+    public void expireSynthetic(UserPrincipal principal, UUID sessionId) {
+        SessionKey key=new SessionKey(principal.getAccountId(),principal.getOrganizationId(),sessionId);
+        prepared.computeIfPresent(key,(k,b)->new Bound(b.token(),b.customer(),b.event(),b.revision(),System.nanoTime()-1));
+    }
+    public record Receipt(boolean replayed, long revision) {}
+    private record Intent(UUID org, UUID customer, UUID event, long revision, String addition) {}
+    @Transactional
+    public Receipt append(UserPrincipal principal, UUID eventId, Request request) {
+        if (request==null || request.intentId()==null || request.expectedRevision()==null || request.expectedRevision()<0 || request.addition()==null || request.addition().isBlank() || request.sessionId()==null || request.token()==null) throw denied();
+        lockSession(principal,request.sessionId());
+        CustomerEvent event=authorize(principal,eventId,request.customerId());
+        UUID actor=principal.getAccountId(), org=principal.getOrganizationId();
+        SessionKey session=new SessionKey(actor,org,request.sessionId());
+        Bound bound=prepared.get(session);
+        if (bound==null || !bound.token().equals(request.token()) || !bound.customer().equals(request.customerId()) || !bound.event().equals(eventId) || bound.revision()!=request.expectedRevision()) throw denied();
+        if (System.nanoTime()-bound.expires()>=0) { prepared.remove(session,bound); throw denied(); }
+        jdbc.queryForObject("SELECT pg_advisory_xact_lock(hashtextextended(?, 0)) IS NULL",Boolean.class,actor+":"+request.intentId());
+        String addition=request.addition().trim();
+        Intent desired=new Intent(org,request.customerId(),eventId,request.expectedRevision(),addition);
+        List<Intent> prior=jdbc.query("SELECT organization_id, customer_id, event_id, expected_revision, addition FROM customer_event_memo_intents WHERE actor_id=? AND intent_id=?",(rs,n)->new Intent(rs.getObject(1,UUID.class),rs.getObject(2,UUID.class),rs.getObject(3,UUID.class),rs.getLong(4),rs.getString(5)),actor,request.intentId());
+        if (!prior.isEmpty()) { if (!prior.get(0).equals(desired)) throw conflict(); return new Receipt(true,event.getRevision()); }
+        if (event.getRevision()!=request.expectedRevision()) { prepared.remove(session,bound); throw conflict(); }
+        String note=event.getNote(); event.updateNote(note==null?addition:note+"\n"+addition); events.flush();
+        jdbc.update("INSERT INTO customer_event_memo_intents(actor_id,intent_id,organization_id,customer_id,event_id,expected_revision,addition) VALUES (?,?,?,?,?,?,?)",actor,request.intentId(),org,request.customerId(),eventId,request.expectedRevision(),addition);
+        return new Receipt(false,event.getRevision());
+    }
+    private void lockSession(UserPrincipal principal, UUID sessionId) {
+        if (principal==null || principal.getAccountId()==null || principal.getOrganizationId()==null || sessionId==null) throw denied();
+        String key="synthetic-session:"+principal.getAccountId()+":"+principal.getOrganizationId()+":"+sessionId;
+        jdbc.queryForObject("SELECT pg_advisory_xact_lock(hashtextextended(?, 0)) IS NULL",Boolean.class,key);
+    }
+    private CustomerEvent authorize(UserPrincipal principal, UUID eventId, UUID customerId) {
+        if (principal==null || principal.getAccountId()==null || principal.getOrganizationId()==null || principal.getPublicId()==null || !"MANAGER".equals(principal.getRole()) || eventId==null || customerId==null) throw denied();
+        UUID actor=principal.getAccountId(), org=principal.getOrganizationId();
+        Optional<User> ext=users.findByExternalAccountId(actor);
+        Optional<User> resolved=ext.isPresent()?ext:users.externalAccountExistsIncludingDeleted(actor)?Optional.empty():users.findByAccountId(actor);
+        User manager=resolved.filter(m->m.getRole()==UserRole.MANAGER && org.equals(m.getOrganizationId()) && principal.getPublicId().equals(m.getPublicId())).orElseThrow(AiMemoAppendService::denied);
+        User customer=users.findByOrganizationIdAndRoleAndPublicId(org,UserRole.CUSTOMER,customerId).orElseThrow(AiMemoAppendService::denied);
+        Relation relation=relations.findByManagerAndCustomerForUpdate(manager,customer).orElseThrow(AiMemoAppendService::denied);
+        if (relation.getStatus()!=RelationStatus.ACTIVE || !org.equals(relation.getOrganizationId())) throw denied();
+        CustomerEvent event=events.findByOrganizationIdAndPublicIdForUpdate(org,eventId).orElseThrow(AiMemoAppendService::denied);
+        if (event.getStatus()!=CustomerEventStatus.PLANNED || !event.getCustomer().getPublicId().equals(customerId)) throw denied();
+        return event;
+    }
+    private static CustomException denied() { return new CustomException(ExceptionStatus.ACCESS_DENIED); }
+    private static CustomException conflict() { return new CustomException(ExceptionStatus.CUSTOMER_EVENT_REVISION_CONFLICT); }
+}
