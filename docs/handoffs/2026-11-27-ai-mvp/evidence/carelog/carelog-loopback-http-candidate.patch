@@ -0,0 +1,35 @@
+package carelog.carelog.preparation;
+
+import java.util.Objects;
+import java.util.Optional;
+
+/** 합성 실험 전용. 실제 인증, 영속화, HTTP 또는 모델과 연결하지 않는다. */
+final class PlannedVisitExperiment {
+    record Scope(String workspace, String customer, String event) {}
+    record Visit(Scope scope, String revision, boolean planned, String note) {}
+    record SaveIntent(String id, Scope scope, String confirmedRevision, String addition) {}
+    enum SaveResult { APPLIED, REPLAYED, CONFLICT, UNAVAILABLE }
+
+    /** 각 호출은 현재 권한과 대상 관계를 확인하고, 실패 시 내용을 반환하지 않는다. */
+    interface VisitAccess { Optional<Visit> authorizedRead(Scope scope); }
+    /** 권한 확인·이전 의도 조회·버전 비교·추가·의도 기록을 하나의 원자 연산으로 수행한다. */
+    interface AtomicSave { SaveResult appendIfAuthorized(SaveIntent intent); }
+    private final VisitAccess access;
+    private final AtomicSave save;
+    PlannedVisitExperiment(VisitAccess access, AtomicSave save) { this.access = access; this.save = save; }
+
+    Optional<String> prepare(Scope scope) {
+        Optional<Visit> before = access.authorizedRead(scope);
+        if (before.isEmpty() || !before.get().planned() || !scope.equals(before.get().scope())) return Optional.empty();
+        // 이 실험은 정해진 합성 레코드만 사용한다.
+        if (!new Visit(new Scope("W1", "C1", "E1"), "v1", true, "이전 상담 내용 확인").equals(before.get())) return Optional.empty();
+        String text = "방문 목적: 이전 상담 내용 확인";
+        Optional<Visit> after = access.authorizedRead(scope);
+        return after.filter(before.get()::equals).map(ignored -> text);
+    }
+    SaveResult save(SaveIntent intent) {
+        if (intent == null || intent.scope() == null || blank(intent.id()) || blank(intent.confirmedRevision()) || blank(intent.addition())) return SaveResult.UNAVAILABLE;
+        return Objects.requireNonNull(save.appendIfAuthorized(intent));
+    }
+    private static boolean blank(String value) { return value == null || value.isBlank(); }
+}
diff --git a/carelog-be/src/main/java/carelog/carelog/preparation/SyntheticPreparation.java b/carelog-be/src/main/java/carelog/carelog/preparation/SyntheticPreparation.java
new file mode 100644
index 0000000..b12286b
--- /dev/null
+++ b/carelog-be/src/main/java/carelog/carelog/preparation/SyntheticPreparation.java
@@ -0,0 +1,73 @@
+package carelog.carelog.preparation;
+
+import java.util.*;
+
+/** 고정 합성 데이터 전용 비연결 실험. 운영 인가나 CRM 연동 계약이 아니다. */
+final class SyntheticPreparation {
+    record Scope(String workspace, String customer, String event) {}
+    record Source(String id, String version, String text) {}
+    record Snapshot(Scope scope, boolean authorized, boolean planned, Source event, List<Source> history) {
+        Snapshot { history = List.copyOf(history); }
+    }
+    record Briefing(String purpose, String context, String check, String question, List<Source> evidence) {}
+    interface FixtureAccess { Snapshot read(Scope scope); }
+    interface Generator { Briefing generate(Snapshot snapshot); }
+
+    static final Scope SCOPE = new Scope("W1", "C1", "E1");
+    static final Source EVENT = new Source("E1.purpose", "v1", "이전 상담 내용 확인");
+    static final Source HISTORY = new Source("H1.note", "v1", "일정 변경 요청, 다음 방문에서 이전 상담 내용 재확인");
+    static final Snapshot GOOD = new Snapshot(SCOPE, true, true, EVENT, List.of(HISTORY));
+    static final Briefing EXPECTED = new Briefing("방문 목적: 이전 상담 내용 확인", "지난 기록에는 일정 변경 요청과 다음 방문의 상담 내용 재확인이 남아 있습니다.", "일정 변경 요청의 확정 여부를 확인해 보세요.", "달라진 요청 사항이 있나요?", List.of(EVENT, HISTORY));
+
+    // 허용된 단일 합성 원본에 대한 고정 출력만 수락한다. 임의 텍스트는 실행하지 않는다.
+    static Briefing deterministic(Snapshot snapshot) {
+        if (!GOOD.equals(snapshot)) throw new IllegalStateException("unsupported fixture");
+        return EXPECTED;
+    }
+    static final class Session {
+        private final FixtureAccess access;
+        private final Generator generator;
+        private long generation;
+        private Scope selected;
+        private Snapshot source;
+        private Briefing latest;
+        private boolean active = true;
+        Session(FixtureAccess access, Generator generator) { this.access = access; this.generator = generator; }
+        synchronized void select(Scope scope) { generation++; selected = scope; source = null; latest = null; }
+        synchronized void close() { generation++; active = false; selected = null; source = null; latest = null; }
+        synchronized void cancel() { generation++; source = null; latest = null; }
+        private Snapshot checked(Scope scope) {
+            Snapshot s = access.read(scope);
+            if (s == null || !s.authorized() || !s.planned() || !scope.equals(s.scope())) throw new IllegalStateException("unavailable");
+            return s;
+        }
+        Optional<Briefing> prepare(Scope scope) {
+            final long ticket;
+            final Snapshot before;
+            synchronized (this) {
+                if (!active || scope == null || !scope.equals(selected)) return Optional.empty();
+                generation++; ticket = generation; source = null; latest = null;
+                try { before = checked(scope); } catch (RuntimeException e) { return Optional.empty(); }
+                if (!GOOD.equals(before)) return Optional.empty();
+            }
+            final Briefing result;
+            try { result = generator.generate(before); } catch (RuntimeException e) { return Optional.empty(); }
+            synchronized (this) {
+                if (!active || generation != ticket || !scope.equals(selected)) return Optional.empty();
+                try {
+                    if (!before.equals(checked(scope)) || !GOOD.equals(before) || !EXPECTED.equals(result)) return Optional.empty();
+                } catch (RuntimeException e) { return Optional.empty(); }
+                source = before; latest = result;
+                return Optional.of(result);
+            }
+        }
+        synchronized Optional<Briefing> reopen() {
+            if (!active || latest == null) return Optional.empty();
+            try {
+                if (source.equals(checked(selected))) return Optional.of(latest);
+            } catch (RuntimeException ignored) { }
+            generation++; source = null; latest = null;
+            return Optional.empty();
+        }
+    }
+}
