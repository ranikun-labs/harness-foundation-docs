@@ -0,0 +1,7 @@
+import { defineConfig } from 'vite';
+import path from 'node:path';
+import react from '@vitejs/plugin-react';
+
+const backend = process.env.SYNTHETIC_BACKEND_URL;
+if (!backend || !/^http:\/\/127\.0\.0\.1:\d+$/.test(backend)) throw new Error('A loopback synthetic backend is required');
+export default defineConfig({ plugins: [react()], resolve: { alias: { '@': path.resolve(__dirname, './src') } }, server: { host: '127.0.0.1', proxy: { '/synthetic': { target: backend, rewrite: p => p.replace(/^\/synthetic/, '') } } } });
