+import { render, fireEvent, waitFor } from '@testing-library/react';
+import { MemoryRouter } from 'react-router';
+import { expect, it, vi } from 'vitest';
+import { EventDetail } from '@/components/schedule/EventDetail';
+import { I18nProvider } from '@/i18n/I18nContext';
+import type { CustomerEvent } from '@/domain/customerEvent';
+
+it('keeps the opened event revision after a refreshed event arrives', async () => {
+  const original: CustomerEvent = { id: 'event', customerId: 'customer', status: 'PLANNED', scheduledAt: '2026-12-01T10:00:00Z', note: '처음', revision: 1 };
+  const onEdit = vi.fn().mockResolvedValue(original);
+  const view = (event: CustomerEvent) => <MemoryRouter><I18nProvider locale="ko"><EventDetail event={event} customerName="합성 고객" customerPath="/" now={new Date('2026-11-27T00:00:00Z')} onEdit={onEdit} /></I18nProvider></MemoryRouter>;
+  const { container, rerender } = render(view(original));
+  fireEvent.click(container.querySelector('[data-event-action="edit"]')!);
+  rerender(view({ ...original, note: '다른 사용자 변경', revision: 2 }));
+  fireEvent.change(container.querySelector('[data-event-field="note"]')!, { target: { value: '나의 편집' } });
+  fireEvent.submit(container.querySelector('[data-event-form]')!);
+  await waitFor(() => expect(onEdit).toHaveBeenCalled());
+  expect(onEdit.mock.calls[0][1]).toMatchObject({ revision: 1, note: '처음' });
+});
