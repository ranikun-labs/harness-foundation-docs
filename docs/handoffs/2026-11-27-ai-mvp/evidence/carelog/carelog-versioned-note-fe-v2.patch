diff --git a/src/local-proof.tsx b/src/local-proof.tsx
new file mode 100644
index 0000000..bdab218
--- /dev/null
+++ b/src/local-proof.tsx
@@ -0,0 +1,21 @@
+import { useState } from 'react';
+import { createRoot } from 'react-dom/client';
+
+function LocalProof() {
+  const [summary, setSummary] = useState('');
+  const [status, setStatus] = useState('');
+  async function call(path: string) {
+    const response = await fetch(`/synthetic/${path}`, { method: 'POST' });
+    const text = await response.text();
+    if (path === 'prepare') setSummary(response.ok ? text : '');
+    else { if (response.status === 403) setSummary(''); setStatus(text); }
+  }
+  return <main><h1>합성 방문 준비</h1><button id="prepare" onClick={() => void call('prepare')}>방문 준비</button>
+    {summary && <p id="summary">{summary}</p>}
+    <button id="save" disabled={!summary} onClick={() => void call('save')}>명시 저장</button>
+    <button id="stale" disabled={!summary} onClick={() => void call('stale')}>오래된 저장 확인</button>
+    <button id="denied" onClick={() => void call('denied')}>권한 없음 확인</button><output id="result">{status}</output></main>;
+}
+if (import.meta.env.DEV && import.meta.env.VITE_SYNTHETIC_PANEL === 'enabled') {
+  createRoot(document.getElementById('root')!).render(<LocalProof />);
+}
